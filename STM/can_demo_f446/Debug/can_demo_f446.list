080010dc <Mrf24j_rx_flush>:
uint16_t Mrf24j_address16_read(void) {
  uint8_t a16h = Mrf24j_read_short(MRF_SADRH);
  return a16h << 8 | Mrf24j_read_short(MRF_SADRL);
}

